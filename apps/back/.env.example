# Copy to .env and fill in. Validated at startup: the app refuses to start
# with a clear message when a required variable is missing or invalid.

# --- App -------------------------------------------------------------------
# development | production | test (default: development)
# production also switches logs to JSON (for Loki/Grafana)
NODE_ENV=development
# default: 3000
PORT=3000
# self-hosted | saas (default: self-hosted). self-hosted: the open-source
# app, you choose the AI provider and model and may set a default company
# token. saas: our hosted service, the AI is fixed (Mistral Large 4) and the
# variables marked "self-hosted only" are refused.
# HEYJUSTIN_EDITION=self-hosted

# --- Database (required) ---------------------------------------------------
# Matches the local PostgreSQL of docker-compose.yaml
DATABASE_URL=postgresql://postgres:example@localhost:5432/justin

# --- Logging -----------------------------------------------------------------
# Required. Key of the HMAC turning personal identifiers (phone numbers) into
# pseudonyms in logs. At least 32 characters: openssl rand -hex 32
LOG_HASH_SECRET=
# Optional. Log level threshold, e.g. ">=log" (default: every level), ">=debug", "warn,error"
# NEST_LOG_LEVEL=>=debug

# --- AI (required) -----------------------------------------------------------
# API key of the provider (console.mistral.ai → API keys). Optional for
# openai-compatible when the server needs none (e.g. a local Ollama).
AI_API_KEY=
# Self-hosted only. Provider of the language models: mistral | openai-compatible
AI_PROVIDER=mistral
# Self-hosted only. Model reading the receipts (images and PDF, with
# structured output), at its default reasoning. Check its accuracy on real
# receipts: a weaker model misreads blurry photos.
AI_EXTRACTION_MODEL=mistral-large-4
# Self-hosted, openai-compatible only: base URL of the API, e.g.
# http://localhost:11434/v1
# AI_BASE_URL=

# --- Companies (required) ---------------------------------------------------
# Key encrypting the companies' secrets (Pennylane API tokens) in the
# database: openssl rand -hex 32. Keep it: without it, every token must be
# entered again.
SECRETS_ENCRYPTION_KEY=

# --- Pennylane -----------------------------------------------------------------
# Self-hosted only, optional. API token of a single-company install: at startup, the company
# 00000000-0000-7000-8000-000000000001 ("Default") is created with it, or
# gets it (stored encrypted). Attach the users to that company id.
# In Pennylane: Settings → Connectivity → Developers → Generate an API token
# (API V2, "Read and write"). A test company: profile → Test environment.
PENNYLANE_API_TOKEN=
# Optional. API base URL (default: https://app.pennylane.com/api/external/v2).
# PENNYLANE_BASE_URL=
# e2e tests only (npm run test:e2e): token of a Pennylane sandbox company,
# never a production one: the tests create suppliers and invoices. Without
# it, the Pennylane e2e tests are skipped.
# PENNYLANE_SANDBOX_TOKEN=

# --- Messaging channels: configure at least one ------------------------------
# A channel is loaded only when its variable is set: the app does not start
# without any.

# Discord: token of the bot (Discord Developer Portal → your app → Bot).
# Users talk to the bot in direct messages.
DISCORD_BOT_TOKEN=

# WhatsApp: not available yet.
